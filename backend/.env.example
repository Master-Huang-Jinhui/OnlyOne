# ============================================
# Only One 环境变量配置
# 使用方法：复制此文件为 .env，然后修改值
# cp .env.example .env
# ============================================

# 服务端口（默认 3000）
PORT=3000

# JWT 密钥（必须修改！用于登录令牌签名，至少32字符）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-change-this-to-a-random-string

# 平台密码加密密钥（必须修改！用于 AES-256 加密平台账号密码，必须32字符）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：修改此密钥后，之前加密的平台密码将无法解密，需要重新输入
ENCRYPTION_KEY=your-encryption-key-32-chars-min-change-this
